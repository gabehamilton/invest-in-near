{#- The chapter itself: its plot from d4, the rest once the frame opens at d5. This is the page without the
    simulation's script: the plot is c30's own geometry (figure.sim-fig, which sim.js redraws in place), the tiles
    are registry displays (li[data-key], whose figures sim.js recomputes), and the sentences it writes live are
    baked inside noscript, so the live page never shows them twice. -#}
<div id="sim" class="sim" data-src="assets/sim.js" data-payload="data/sim.json">
  <figure class="sim-fig" data-at="{{ '%.1f'|format(d4_at) }}" data-fx="fade">
    <p class="eyebrow">{{ copy('film_d4_axis') }}</p>
    <div class="sim-plot-box" style="--r:{{ plot.ratio }}">
      <p class="sim-counts"><span class="sim-lab" data-for="behind" data-at="{{ '%.1f'|format(landed) }}" data-fx="fade">{{ copy('film_plot_behind') }}</span> <span class="sim-lab" data-for="ahead" data-at="{{ '%.1f'|format(landed) }}" data-fx="fade">{{ copy('film_plot_ahead') }}</span></p>
      <svg class="sim-dots" viewBox="{{ plot.viewbox }}" width="100%" aria-hidden="true" focusable="false">
        <line class="sim-axis" x1="0" y1="{{ plot.base }}" x2="{{ plot.w }}" y2="{{ plot.base }}" stroke="#3b404c"/>
        <line class="sim-zero" x1="{{ plot.zero }}" y1="0" x2="{{ plot.zero }}" y2="{{ plot.base }}" stroke="#898781" stroke-dasharray="2 3"/>
        {%- for col in plot.columns %}
        <g class="sim-col" data-at="{{ '%.2f'|format(d4_at + 0.4 + step * loop.index0) }}" data-fx="drop">
          {%- for dt in col.dots %}<circle class="dot{{ ' is-ahead' if dt.filled }}" cx="{{ col.cx }}" cy="{{ dt.cy }}" r="4.2"{% if dt.filled %} fill="#3987e5"{% else %} fill="#07080c" stroke="#3987e5" stroke-width="1.4"{% endif %}/>{% endfor -%}
        </g>
        {%- endfor %}
        {%- for mk in plot.marks if mk.mark != 'zero' %}
        <line class="sim-mark" data-mark="{{ mk.mark }}" data-at="{{ '%.1f'|format(landed + 0.3 + 0.25 * mk.seq) }}" x1="{{ mk.x }}" y1="0" x2="{{ mk.x }}" y2="{{ plot.base }}" stroke="#f1ede4" stroke-width="1"/>
        {%- endfor %}
      </svg>
      {#- one marker to a row, in plot.marks' order, so no marker's leader runs through a label above it -#}
      <div class="sim-labs">
        {%- for mk in plot.marks %}
        <span class="sim-lab" data-mark="{{ mk.mark }}" data-anchor="{{ mk.anchor }}" data-at="{{ '%.1f'|format(landed if mk.mark == 'zero' else landed + 0.3 + 0.25 * mk.seq) }}" data-fx="fade" style="--x:{{ mk.left }}"><span>{{ copy('film_plot_' ~ mk.mark) }}</span></span>
        {%- endfor %}
      </div>
    </div>
  </figure>
  <div class="sim-rest">
    <noscript><p class="lead sim-headline">{{ copy('sim_headline') }}</p></noscript>
    <ul class="sim-tiles">
      {%- for key, label in [('sim_mean_usd', 'mean'), ('sim_median_usd', 'median'), ('sim_p_beat_r', 'beat'), ('sim_es95_usd', 'bad'), ('sim_exit_days', 'exit')] %}
      <li class="sim-tile" data-key="{{ key }}"><p class="sim-tile-l">{{ copy('film_tile_' ~ label) }}</p><p class="sim-tile-v">{% if label == 'beat' %}{{ copy('film_tile_about') }} {% endif %}{{ num(key) }}{% if label == 'beat' %} {{ copy('film_tile_of') }} {{ num('sim_dots') }}{% endif %}</p></li>
      {%- endfor %}
    </ul>
    <noscript>
    {%- set why = copy('sim_why_typical') %}
    {%- if why|trim %}
    <p class="sim-why">{{ why }}</p>
    {%- endif %}
    <p class="sim-hurdle">{{ copy('sim_hurdle') }} {{ copy('sim_hurdle_cost') }}</p>
    <p class="note sim-assume">{{ copy('film_desk_assumption') }}</p>
    <h3 class="sub sim-left-h">{{ copy('sim_left_h') }}</h3>
    <ul class="sim-left">
      {%- for k in ['failure', 'lst', 'rates', 'costs', 'accounting', 'wrongway'] %}
      <li>{{ copy('sim_left_' ~ k) }}</li>
      {%- endfor %}
    </ul>
    <p class="note">{{ copy('sim_noscript') }}</p>
    </noscript>
    <p class="note sim-note">{{ copy('film_desk_note') }}</p>
  </div>
</div>
</section>
{%- endif %}
</div>
</div>
{%- endautoescape %}
