{#-
  The film: the stage at the top of index.html, included only when the build supplies the film context
  (orbit geometry, sky, desk frame). Every scene is a section in order and every shot a div holding its real
  text, baked figures, chips and settled SVG, so the page reads as an article without JavaScript.

  Markup contract (film.js reads all of it from the DOM and holds no copy or figures):
  - section.scene[data-scene][data-claims][data-charts] with an h2.scene-title;
  - div.shot[data-shot][data-dur] with exactly one p.cap (the caption band text);
  - in-shot timed elements carry data-at / data-out in seconds from the shot's start; the title scene's persistent
    layer (div.layer) carries data-at in seconds from the scene's start;
  - the orbit's geometry is in data-* on the svg and its bodies; labels are HTML placed in percent;
  - .stamp[data-verdict] uses the exact verdict word; chips link to #claim-<id>;
  - div[data-orbit-slot] marks where film.js shows the title's orbit again (l2);
  - the title's second beat (div.shot[data-orbit="pay"], what holding pays) morphs the same orbit: the svg carries
    the blue ring's two radii (data-ring-money, data-ring-pay) and the dollar ring's pay radius (data-usd-pay); each
    body carries data-r-money and, when its currency has a policy rate, data-r-pay (with data-inside-pay when that
    rate is below NEAR's staking yield), else data-norate; every element that belongs to one reading (labels,
    legend items, scale caption, leaders, bracket, gap label) carries data-when="money" or data-when="pay", and
    film.css shows one set at a time (the money set without JavaScript);
  - the third beat (div.shot[data-orbit="rank"], both at once) resolves the orbit into a ranked ladder: each ranked
    body and g.o-core carry data-rank-x / data-rank-y (its place on the ladder, in svg units), and the
    ladder (g.o-ladder), its labels and legend items carry data-when="rank";
  - section.scene[data-short] names the scene in the transport when its full title does not fit.
  Durations are structure: each caption is written to at most seventeen characters a second of its shot.
-#}
{%- import '_macros.html.j2' as m with context -%}
{%- autoescape true -%}
{%- set D = {
  't1': 3.2, 't2': 5.5, 't3': 8.0, 'tpay': 7.0, 'trank': 8.5, 't4': 5.7,
  'w1': 3.5, 'w2': 6.5, 'w4': 6.0, 'w5': 4.5,
  'm1': 6.5, 'm2': 6.0, 'm3': 6.0, 'm4': 7.0, 'm5': 5.0, 'm6': 3.5,
  'y1': 7.0, 'y2': 5.5, 'y3': 6.5, 'y4': 5.0, 'y5': 7.0, 'y6': 4.0, 'y7': 3.5,
  'c1': 6.0, 'c2': 6.5, 'c3': 6.0, 'c4': 7.0,
  'l1': 6.5, 'l2': 6.5,
  'd1': 5.6, 'd2': 6.0, 'd3': 6.5, 'd4': 7.0, 'd5': 2.0
} -%}
{%- set orbit = film.orbit -%}
{%- set pay_keys = ['y_lst_365', 'ffcomp_365', 'spread_adj_365', 'spread_adj_365_dir', 'pay_n_below', 'pay_n_with_rate'] -%}
{%- set ns_pay = namespace(ok=orbit.pay is not none) -%}
{%- for k in pay_keys %}{% if (numbers.get(k) or {}).get('value') is none %}{% set ns_pay.ok = false %}{% endif %}{% endfor -%}
{%- set pay = orbit.pay if ns_pay.ok else none -%}
{%- set rank_keys = ['hold_near_net', 'hold_near_rank', 'hold_n_ranked', 'y_lst_365', 'g_365'] -%}
{%- set ns_rank = namespace(ok=pay is not none and orbit.rank is not none) -%}
{%- for k in rank_keys %}{% if (numbers.get(k) or {}).get('value') is none %}{% set ns_rank.ok = false %}{% endif %}{% endfor -%}
{%- set rank = orbit.rank if ns_rank.ok else none -%}
{%- set desk = film.desk -%}
{%- set turn = verdicts.get('H1', {}).get('verdict') == 'Refuted' and verdicts.get('H1b', {}).get('verdict') == 'Supported' -%}
{%- set survive = turn and verdicts.get('H3', {}).get('verdict') == 'Supported' -%}

{%- macro shot_open(sid, cls='', orbit='') -%}
<div class="shot{{ ' ' ~ cls if cls }}" id="{{ sid }}" data-shot="{{ sid }}" data-dur="{{ D[sid] }}"{% if orbit %} data-orbit="{{ orbit }}"{% endif %}>
{%- endmacro -%}

{%- macro cap(text_markup) -%}
<p class="cap">{{ text_markup }}</p>
</div>
{%- endmacro -%}

{#- which months a set of figures is from, from the registry's month keys (earliest and latest): " Policy rates as
    of <month> to <month>; money growth over each currency's latest year, ending <month> to <month>." -#}
{%- macro span(ks) -%}{{ num(ks[0]) }}{% if ks[1] != ks[0] %} {{ copy('film_asof_to') }} {{ num(ks[1]) }}{% endif %}{%- endmacro -%}
{%- macro asof(rates, money=none) -%}
{%- if rates %} {{ copy('film_asof_rates') }} {{ span(rates) }}{% if money %}; {{ copy('film_asof_money') }} {{ span(money) }}{% endif %}.{% endif -%}
{%- endmacro -%}

{%- macro fig(value, label, at, cls='') -%}
<p class="fig{{ ' ' ~ cls if cls }}" data-at="{{ at }}"><span class="fig-v">{{ value }}</span><span class="fig-l">{{ label }}</span></p>
{%- endmacro -%}

{#- An exhibit: the claim, its test and its figures on the left (figures from the caller), its chart on the right.
    stamped=true stamps the verdict on the same frame (the shorter shots of the cost scene). -#}
{%- macro exhibit(sid, cid, chart, capt, focus='', stamped=false) -%}
{%- set figs = caller() -%}
{{ shot_open(sid, 'is-exhibit' ~ (' is-stamped' if stamped else '')) }}
<div class="split exhibit">
  <div class="words">
    <p class="eyebrow">{{ m.claim_eyebrow(cid) }}</p>
    <blockquote class="quote">{{ m.as_stated(cid) }}</blockquote>
    <p class="test" data-at="0.4"><span class="k">The test</span> {{ rule(cid, 'test') }}</p>
    <div class="figs">{{ figs }}</div>
  </div>
  <div class="picture">{{ m.chart_shell(chart, 'f-' ~ sid, focus) }}</div>
</div>
{%- if stamped %}
{%- set answer = copy('film_' ~ cid ~ '_answer') %}
<div class="vframe overlay" data-at="2.2">
  <p class="eyebrow">Verdict · claim {{ ident(cid) }} · {{ rule(cid, 'title') }}</p>
  {{ m.stamp(cid, '0') }}
  <p class="sentence">{{ m.claim_sentence(cid) }}</p>
  {%- if answer|trim %}
  <p class="answer">{{ answer }}</p>
  {%- endif %}
</div>
{%- endif %}
{{ cap(capt) }}
{%- endmacro -%}

{%- macro verdict_shot(sid, cid, capt, also='') -%}
{{ shot_open(sid, 'is-verdict') }}
{{ m.film_verdict(cid, also) }}
{{ cap(capt) }}
{%- endmacro -%}

<div class="film" id="film">
<svg class="sky" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
{%- for s in film.sky %}<circle cx="{{ s.cx }}" cy="{{ s.cy }}" r="{{ s.r }}" opacity="{{ s.o }}"/>{% endfor -%}
</svg>
<header class="slate">
  <a class="wordmark" href="#film">{{ copy('film_wordmark') }}</a>
  <p class="slate-scene" aria-hidden="true"></p>
  <nav class="skips" aria-label="Skip">
    {%- if desk %}<a class="skip-link" href="#desk" data-skip="desk">{{ copy('film_skip_desk') }}</a>{% endif %}
    <a class="skip-link" href="#evidence" data-skip="evidence">{{ copy('film_skip_evidence') }}</a>
  </nav>
</header>
<p class="rm-note" hidden>{{ copy('film_rm_note') }} <a href="#evidence" data-article>{{ copy('film_rm_link') }}</a></p>
<div class="scenes">

{#- ---------------------------------------------------------------- scene: the thesis -#}
{#- Three figures in order, each told in words and by the picture: the money figure (t3), the rate figure (tpay, the
    same orbit read for what holding pays) and both at once (trank, the orbit resolving into a ranked ladder). -#}
{%- set t2_at = D.t1 -%}
{%- set t3_at = D.t1 + D.t2 -%}
{%- set tpay_at = D.t1 + D.t2 + D.t3 -%}
{%- set trank_at = tpay_at + (D.tpay if pay else false|int) -%}
{%- set t4_at = trank_at + (D.trank if rank else false|int) -%}
{%- set fmt1 = '%.1f' -%}
<section class="scene" id="scene-title" data-scene="title" data-claims="H1b{{ ' H3 H5' if pay }}" data-charts="c21" data-short="{{ copy('film_scene_title_short') }}" aria-labelledby="st-title">
<h2 class="scene-title" id="st-title">{{ copy('film_scene_title') }}</h2>
<div class="layer split title-split">
  <div class="words">
    <p class="eyebrow">{{ copy('film_t_eyebrow') }}</p>
    {%- set th = rules.get('meta', {}).get('thesis') or '' %}
    {%- set cut = th.find(' relative') %}
    <h1 class="thesis">{% if cut > false|int %}{{ th[:cut] }} <span class="rel" data-at="0.6">{{ th[cut + true|int:] }}</span>{% else %}{{ th }}{% endif %}</h1>
    <div class="heroes">
      {%- set out = (' data-out="' ~ fmt1|format(tpay_at + 0.4) ~ '"')|safe if pay else '' %}
      <div class="hero" data-at="{{ fmt1|format(t2_at + 2.7) }}"{{ out }}><p class="fig-v">{{ num('gap_m2', absolute=true) }}</p><p class="fig-l">{{ copy('film_t_hero1_label') }}</p></div>
      <div class="hero" data-at="{{ fmt1|format(t3_at + 0.3) }}"{{ out }}><p class="fig-v">{{ num('h1b_n_faster') }}<i> of </i>{{ num('n_fiat_money') }}</p><p class="fig-l">{{ copy('film_t_hero2_label') }}</p></div>
      {%- if pay %}
      {%- set out = (' data-out="' ~ fmt1|format(trank_at + 0.4) ~ '"')|safe if rank else '' %}
      <div class="hero is-pay" data-at="{{ fmt1|format(tpay_at + 2.0) }}"{{ out }}><p class="fig-v">{{ num('spread_adj_365', absolute=true) }}</p><p class="fig-l">{{ copy('film_tp_hero1_label') }}</p></div>
      <div class="hero is-pay" data-at="{{ fmt1|format(tpay_at + 3.0) }}"{{ out }}><p class="fig-v">{{ num('pay_n_below') }}<i> of </i>{{ num('pay_n_with_rate') }}</p><p class="fig-l">{{ copy('film_tp_hero2_label') }}</p></div>
      {%- endif %}
      {%- if rank %}
      {%- set out = (' data-out="' ~ fmt1|format(t4_at + 0.3) ~ '"')|safe %}
      <div class="hero is-rank" data-at="{{ fmt1|format(trank_at + 2.4) }}"{{ out }}><p class="fig-v">{{ num('hold_near_rank') }}<i> of </i>{{ num('hold_n_ranked') }}</p><p class="fig-l">{{ copy('film_tr_hero1_label') }}</p></div>
      <div class="hero is-rank" data-at="{{ fmt1|format(trank_at + 3.4) }}"{{ out }}><p class="fig-v">{{ num('hold_near_net') }}</p><p class="fig-l">{{ copy('film_tr_hero2_label') }}</p></div>
      {#- the three figures together before the claims are tested one by one -#}
      <div class="recap" data-at="{{ fmt1|format(t4_at + 0.3) }}" data-fx="slam">
        <p><b>{{ num('h1b_n_faster') }}<i> of </i>{{ num('n_fiat_money') }}</b> {{ copy('film_t4_recap_money') }}</p>
        <p><b>{{ num('pay_n_below') }}<i> of </i>{{ num('pay_n_with_rate') }}</b> {{ copy('film_t4_recap_pay') }}</p>
        <p><b>{{ num('hold_near_rank') }}<i> of </i>{{ num('hold_n_ranked') }}</b> {{ copy('film_t4_recap_rank') }}</p>
      </div>
      {%- endif %}
    </div>
    {%- if pay %}
    <div class="notes">
      <p class="note tp-note" data-at="{{ fmt1|format(tpay_at + 4.0) }}" data-fx="fade"{% if rank %} data-out="{{ fmt1|format(trank_at + 0.4) }}"{% endif %}>{{ copy('film_tp_note') }}{{ asof(pay.months) }}</p>
      {%- if rank %}
      <p class="note tp-note" data-at="{{ fmt1|format(trank_at + 4.4) }}" data-fx="fade">{{ copy('film_tr_note') }}{{ asof(rank.months, rank.money_months) }}</p>
      {%- endif %}
    </div>
    {%- endif %}
    <p class="tested" data-at="{{ fmt1|format(t4_at + 0.3) }}"><span class="k">{{ copy('film_t_tested') }}</span> {{ m.vchip('H1b', link=true) }}{% if pay %} {{ m.vchip('H3', link=true) }} {{ m.vchip('H5', link=true) }}{% endif %}</p>
  </div>
  <div class="picture">
    <figure class="orbit" id="orbit" aria-label="{{ copy('film_orbit_aria') }}{% if pay %} {{ copy('film_orbit_aria_pay') }}{% endif %}{% if rank %} {{ copy('film_orbit_aria_rank') }}{% endif %}" data-top="{{ orbit.top }}" data-step="{{ orbit.step }}">
      <div class="o-cam">
        <svg class="o-svg" viewBox="0 0 {{ orbit.w }} {{ orbit.h }}" data-cx="{{ orbit.cx }}" data-cy="{{ orbit.cy }}" data-k="{{ orbit.k }}" data-ring-money="{{ orbit.r_near }}"{% if pay %} data-ring-pay="{{ pay.r_near }}"{% if pay.r_usd is not none %} data-usd-pay="{{ pay.r_usd }}"{% endif %}{% endif %} data-scale="{% for r in orbit.grid %}{{ loop.index * orbit.step }}{{ ' ' if not loop.last }}{% endfor %}" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="oN"><stop offset="0" stop-color="#3987e5" stop-opacity=".55"/><stop offset="1" stop-color="#3987e5" stop-opacity="0"/></radialGradient>
            <radialGradient id="oU"><stop offset="0" stop-color="#d95926" stop-opacity=".5"/><stop offset="1" stop-color="#d95926" stop-opacity="0"/></radialGradient>
            <radialGradient id="oE"><stop offset="0" stop-color="#199e70" stop-opacity=".5"/><stop offset="1" stop-color="#199e70" stop-opacity="0"/></radialGradient>
            <radialGradient id="oC"><stop offset="0" stop-color="#b9b5ab" stop-opacity=".45"/><stop offset="1" stop-color="#b9b5ab" stop-opacity="0"/></radialGradient>
          </defs>
          <g class="o-grid">
            {%- for r in orbit.grid %}<circle cx="{{ orbit.cx }}" cy="{{ orbit.cy }}" r="{{ r }}" data-v="{{ loop.index * orbit.step }}"/>{% endfor -%}
            <line x1="{{ orbit.cx }}" y1="{{ orbit.cy }}" x2="{{ orbit.cx }}" y2="{{ '%.1f'|format(orbit.cy|float - orbit.R|float) }}"/>
          </g>
          {%- if rank %}
          {#- the ladder: one value axis, the zero line, a tick per step (film.js writes their values) and a hairline
              from each dot to its label -#}
          <g class="o-ladder" data-when="rank">
            <line class="o-axis" x1="{{ rank.ax }}" y1="{{ rank.y_top }}" x2="{{ rank.ax }}" y2="{{ rank.y_bot }}"/>
            {%- for t in rank.ticks %}<line class="o-rt" data-tick="{{ t.v }}" x1="{{ rank.ax|float - 4 }}" y1="{{ t.y }}" x2="{{ rank.ax|float + 4 }}" y2="{{ t.y }}"/>{% endfor %}
            <line class="o-zero" x1="{{ rank.zero.x1 }}" y1="{{ rank.zero.y }}" x2="{{ rank.zero.x2 }}" y2="{{ rank.zero.y }}"/>
            {%- for p in [rank.near] + rank.bodies|map(attribute='rank')|list %}<line class="o-rlead" x1="{{ p.leader.x1 }}" y1="{{ p.leader.y1 }}" x2="{{ p.leader.x2 }}" y2="{{ p.leader.y2 }}"/>{% endfor %}
          </g>
          {%- endif %}
          <path class="o-wash" d="{{ orbit.wash }}" fill-rule="evenodd"/>
          <circle class="o-ring" data-entity="usd" cx="{{ orbit.cx }}" cy="{{ orbit.cy }}" r="{{ orbit.r_usd }}"/>
          <circle class="o-ring" data-entity="near" cx="{{ orbit.cx }}" cy="{{ orbit.cy }}" r="{{ orbit.r_near }}"/>
          <g class="o-bracket" data-when="money"><line x1="{{ orbit.bracket.x }}" y1="{{ orbit.bracket.y1 }}" x2="{{ orbit.bracket.x }}" y2="{{ orbit.bracket.y2 }}"/></g>
          {%- for b in orbit.bodies %}
          {%- set grad = {'usd': 'oU', 'eur': 'oE'}.get(b.entity, 'oC') %}
          <g class="o-body" data-code="{{ b.code }}" data-entity="{{ b.entity }}" data-i="{{ b.i }}" data-ux="{{ b.ux }}" data-uy="{{ b.uy }}" data-r-money="{{ b.r }}"{% if b.inside %} data-inside{% endif %}{% if b.negative %} data-negative{% endif %}{% if pay %}{% if b.pay %} data-r-pay="{{ b.pay.r }}"{% if b.pay.inside %} data-inside-pay{% endif %}{% else %} data-norate{% endif %}{% endif %}{% if rank and b.rank %} data-rank-x="{{ b.rank.x }}" data-rank-y="{{ b.rank.y }}"{% endif %}>
            {%- if b.label.leader %}<line class="o-leader" data-when="money" x1="{{ b.label.leader.x1 }}" y1="{{ b.label.leader.y1 }}" x2="{{ b.label.leader.x2 }}" y2="{{ b.label.leader.y2 }}"/>{% endif -%}
            {%- if pay and b.pay and b.pay.label.leader %}<line class="o-leader" data-when="pay" x1="{{ b.pay.label.leader.x1 }}" y1="{{ b.pay.label.leader.y1 }}" x2="{{ b.pay.label.leader.x2 }}" y2="{{ b.pay.label.leader.y2 }}"/>{% endif -%}
            <circle class="o-halo" cx="{{ b.x }}" cy="{{ b.y }}" r="17" fill="url(#{{ grad }})"/><circle class="o-dot" cx="{{ b.x }}" cy="{{ b.y }}" r="5.5"/>
          </g>
          {%- endfor %}
          <g class="o-core"{% if rank %} data-rank-x="{{ rank.near.x }}" data-rank-y="{{ rank.near.y }}"{% endif %}><circle cx="{{ orbit.cx }}" cy="{{ orbit.cy }}" r="26" fill="url(#oN)"/><circle cx="{{ orbit.cx }}" cy="{{ orbit.cy }}" r="4"/></g>
        </svg>
        {%- for b in orbit.bodies %}
        <span class="o-lab" data-when="money" data-for="{{ b.code }}" data-entity="{{ b.entity }}" data-anchor="{{ b.label.anchor }}" data-valign="{{ b.label.valign }}"{% if b.inside %} data-inside{% endif %} style="{{ b.label.style }}">{{ b.code }}{% if b.valued and b.key %} {{ num(b.key) }}{% endif %}</span>
        {%- endfor %}
        <span class="o-lab" data-when="money" data-for="near" data-entity="near" data-anchor="{{ orbit.near_label.anchor }}" data-valign="{{ orbit.near_label.valign }}" style="{{ orbit.near_label.style }}">{{ copy('film_orbit_near') }}{% if orbit.near_lines > true|int %}<br>{% else %} {% endif %}{{ num('g_365_at_m2') }}</span>
        <span class="o-lab o-gaplab" data-when="money" data-for="gap" data-anchor="{{ orbit.bracket.label.anchor }}" data-valign="{{ orbit.bracket.label.valign }}" style="{{ orbit.bracket.label.style }}">{{ num('gap_m2', absolute=true) }} {{ num('gap_m2_dir') }}</span>
        {%- if pay %}
        {%- for b in pay.bodies %}
        <span class="o-lab" data-when="pay" data-for="{{ b.code }}" data-entity="{{ b.entity }}" data-anchor="{{ b.pay.label.anchor }}" data-valign="{{ b.pay.label.valign }}"{% if b.pay.inside %} data-inside{% endif %} style="{{ b.pay.label.style }}">{{ b.code }}{% if b.code == 'USD' %} {{ copy('film_tp_now') }}{% endif %}{% if b.pay.valued %} {{ num(b.pay.key) }}{% endif %}</span>
        {%- endfor %}
        <span class="o-lab" data-when="pay" data-for="near" data-entity="near" data-anchor="{{ pay.near_label.anchor }}" data-valign="{{ pay.near_label.valign }}" style="{{ pay.near_label.style }}">{{ copy('film_orbit_near_pay') }} {{ num('y_lst_365') }}</span>
        {%- endif %}
        {%- if rank %}
        {%- for b in rank.bodies %}
        <span class="o-lab" data-when="rank" data-for="{{ b.code }}" data-entity="{{ b.entity }}" data-anchor="start" data-valign="middle" style="{{ b.rank.label.style }}">{{ b.code }} {{ num(b.rank.key) }}</span>
        {%- endfor %}
        <span class="o-lab" data-when="rank" data-for="near" data-entity="near" data-anchor="start" data-valign="middle" style="{{ rank.near.label.style }}">{{ copy('film_orbit_near_rank') }} {{ num('hold_near_net') }}</span>
        <span class="o-lab o-zl" data-when="rank" data-for="up" data-anchor="start" data-valign="above" style="{{ rank.up.style }}">{{ copy('film_tr_up') }}</span>
        <span class="o-lab o-zl" data-when="rank" data-for="down" data-anchor="start" data-valign="below" style="{{ rank.down.style }}">{{ copy('film_tr_down') }}</span>
        {%- endif %}
      </div>
      <ul class="o-legend">
        {%- for ent in ['near', 'usd', 'eur', 'other', 'hollow'] %}
        <li data-entity="{{ ent }}" data-when="money"><i class="k{{ ' ring' if ent == 'near' }}{{ ' hollow' if ent == 'hollow' }}"></i>{{ copy('film_legend_' ~ ent) }}</li>
        {%- if pay %}
        <li data-entity="{{ ent }}" data-when="pay"><i class="k{{ ' ring' if ent == 'near' }}{{ ' hollow' if ent == 'hollow' }}"></i>{{ copy('film_legend_pay_' ~ ent) }}</li>
        {%- endif %}
        {%- if rank and ent != 'hollow' %}
        <li data-entity="{{ ent }}" data-when="rank"><i class="k{{ ' ring' if ent == 'near' }}"></i>{{ copy('film_legend_rank_' ~ ent) }}</li>
        {%- endif %}
        {%- endfor %}
      </ul>
      {%- set inst = pay.bodies|selectattr('code', 'in', ['CNY', 'HKD'])|list if pay else [] %}
      {%- if (pay and (inst or pay.norate)) or (rank and rank.unranked) %}
      {#- one line under the legend, its text swapped by beat (stacked in one cell, so it never jumps) -#}
      <p class="o-norate">
        {%- if pay and (inst or pay.norate) %}<span data-when="pay">{% for b in inst %}{{ b.code }}: {{ copy('film_tp_inst_' ~ b.code|lower) }}. {% endfor %}{% if pay.norate %}{{ copy('film_tp_norate') }} {% for b in pay.norate %}{{ b.code }}{{ ', ' if not loop.last else '.' }}{% endfor %}{% endif %}</span>{% endif %}
        {%- if rank and rank.unranked %}<span data-when="rank">{{ copy('film_tr_unranked') }} {% for b in rank.unranked %}{{ b.code }}{{ ', ' if not loop.last else '.' }}{% endfor %}</span>{% endif -%}
      </p>
      {%- endif %}
      <figcaption class="o-scale"><span data-when="money">{{ copy('film_orbit_scale') }}</span>{% if pay %}<span data-when="pay">{{ copy('film_orbit_scale_pay') }}</span>{% endif %}{% if rank %}<span data-when="rank">{{ copy('film_tr_scale') }}</span>{% endif %}</figcaption>
    </figure>
  </div>
</div>
{%- set inside_markup -%}
{%- if orbit.inside %} {{ copy('film_t3_inside') }} {% for b in orbit.inside %}the {{ b.name }}{% if b.key %} ({{ num(b.key) }}){% endif %}{{ ', ' if not loop.last else '.' }}{% endfor %}
{%- else %} {{ copy('film_t3_inside_none') }}{% endif -%}
{%- endset %}
{{ shot_open('t1') }}
{{ cap(copy('film_t1_cap')) }}
{{ shot_open('t2') }}
{{ cap(copy('film_t2_cap')) }}
{{ shot_open('t3') }}
<p class="vh">{{ copy('film_t3_cap') }}{{ inside_markup }}</p>
{{ cap(copy('film_t3_cap') ~ inside_markup) }}
{%- if pay %}
