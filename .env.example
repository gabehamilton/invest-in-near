# Copy to .env (gitignored). Never commit real values.

# BigQuery: run `gcloud auth application-default login` first, then set the
# GCP project that will be billed for queries (the NEAR dataset itself is public).
GCP_PROJECT=
# Hard ceiling per query in bytes (default 50 GB). Queries estimated above this are refused.
BQ_MAX_BYTES_BILLED=53687091200

# NEAR Intents Explorer API JWT from the partner dashboard (partners.near-intents.org).
NEAR_INTENTS_JWT=
# Total dry-run estimate allowed for one `make data` BigQuery run, in GB (default 500).
# Above this the pull stops and prints the per-query estimate; re-run with `--yes` to proceed.
BQ_BUDGET_GB=500
# Optional: BigQuery job location, if auto-detection fails.
BQ_LOCATION=
# NEAR RPC: set to 0 to skip the dense outputs (rpc/dense_samples, protocol_changes, epoch_history); default on.
RPC_DENSE=1

# `make explore`: NEAR AI Cloud API key from https://cloud.near.ai (sent only to cloud-api.near.ai, never printed).
NEAR_AI_API_KEY=
# Optional: a confidential-fleet model id; `make explore` lists the eligible ones if this one is not.
NEAR_AI_MODEL=
